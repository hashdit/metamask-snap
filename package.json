{
  "name": "HashDit-Snap",
  "version": "0.1.0",
  "description": "The HashDit Security MetaMask Snap that screens user's transactions for malicious activity before approving any transaction.",
  "homepage": "https://github.com/MetaMask/template-snap-monorepo#readme",
  "bugs": {
    "url": "https://github.com/Matrix-Devs/HashDit-Snaps-Audit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Matrix-Devs/HashDit-Snap-Audit.git"
  },
  "license": "(MIT-0 OR Apache-2.0)",
  "author": "HashDit Security",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --parallel --topological --verbose run build",
    "install-chrome": "./scripts/install-chrome.sh",
    "lint": "yarn lint:eslint && yarn lint:misc --check",
    "lint:eslint": "eslint . --cache --ext js,ts",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.json' '**/*.md' '!**/CHANGELOG.md' '**/*.yml' --ignore-path .gitignore",
    "start": "yarn workspaces foreach --parallel --interlaced --verbose run start",
    "test": "echo \"TODO\""
  },
  "devDependencies": {
    "@metamask/eslint-config": "^10.0.0",
    "@metamask/eslint-config-jest": "^10.0.0",
    "@metamask/eslint-config-nodejs": "^10.0.0",
    "@metamask/eslint-config-typescript": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.8.2",
    "eslint-plugin-jsdoc": "^39.2.9",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.2.18",
    "typescript": "^4.7.4"
  },
  "packageManager": "yarn@3.2.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "resolutions": {
    "@ardatan/relay-compiler/immutable": "~3.8.4",
    "@graphql-tools/utils": "^12.0.1",
    "@metamask/number-to-bn/bn.js": "^5.2.3",
    "@npmcli/package-json/glob": "^14.0.2",
    "@parcel/reporter-dev-server": "^2.16.4",
    "cacache/glob": "^14.0.2",
    "cookie": "^0.7.2",
    "fast-xml-parser": "^5.12.0",
    "gatsby/express": "^4.22.3",
    "gatsby/path-to-regexp": "~0.1.13",
    "ip-address": "^10.7.4",
    "lodash": "^4.18.1",
    "serialize-javascript": "^7.1.3",
    "sharp": "^0.35.5",
    "socket.io-adapter/ws": "~8.21.3",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1",
    "webpack-dev-middleware": "^7.4.6"
  }
}
